.page, .theme-trigger-content, .theme-sheet, .theme-sheet .theme-option,
.theme-sheet .theme-close, .theme-selected, .theme-sheet-description,
.primary, .subtitle, .formats, .format-tag, .format-description,
.limits, .privacy, .wordmark {
  transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
}
.theme-backdrop { animation: theme-backdrop-in 160ms ease-out; }
.theme-sheet { animation: theme-sheet-in 180ms ease-out; }
@keyframes theme-backdrop-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes theme-sheet-in {
  from { opacity: 0; transform: translateY(12rpx) scale(.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.render-canvas { position: fixed; left: -10000px; top: 0; width: 16px; height: 16px; pointer-events: none; }
